      "name": "Absences",
      "path": "/absences",
      "description": "Record, view, update, and withdraw employee absences",
      "endpoints": {
        "getAll": { "method": "GET", "path": "/absences", "description": "Get all absence records" },
        "getById": { "method": "GET", "path": "/absences/{absencesUniqID}", "description": "Get an absence record" },
        "create": { "method": "POST", "path": "/absences", "description": "Create an absence record" },
