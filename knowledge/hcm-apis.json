        "delete": { "method": "DELETE", "path": "/absences/{absencesUniqID}", "description": "Delete an absence record" },
        "search": { "method": "POST", "path": "/absences/action/findByAdvancedSearchQuery", "description": "Search existing absences" },
        "searchCases": { "method": "POST", "path": "/absences/action/findByAdvancedSearchQueryForCases", "description": "Display absence cases" },
        "getBalance": { "method": "POST", "path": "/absences/action/getAbsenceTypeBalance", "description": "Get absence type balance" },
        "getProjectedBalance": { "method": "POST", "path": "/absences/action/loadProjectedBalance", "description": "Display absence type projected balance" },
        "getDailyDetails": { "method": "POST", "path": "/absences/action/absenceDailyDetailsBreakdown", "description": "Get daily and shift details" },
        "planUse": { "method": "POST", "path": "/absences/action/planUse", "description": "Show absence plan usage" },
        "getUserAccess": { "method": "POST", "path": "/absences/action/getUserAccessDetails", "description": "Retrieve user access details" }
      },
      "children": {
        "attachments": { "path": "child/absenceAttachments", "description": "Absence attachments" },
        "certifications": { "path": "child/absenceEntryCertifications", "description": "Absence certifications" },
        "entryDetails": { "path": "child/absenceEntryDetails", "description": "Individual day breakdown" },
        "entitlements": { "path": "child/absenceEntitlements", "description": "Entitlements consumed" },
        "maternity": { "path": "child/absenceMaternity", "description": "Maternity absence details" },
        "linkedAbsences": { "path": "child/linkedAbsences", "description": "Linked absence records" }
      }
    },
