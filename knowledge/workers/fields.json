{
  "module": "workers",
  "endpoint": "/workers",
  "description": "Employee and worker information - the core resource for person data",
  "dependsOn": null,
  "fields": {
    "PersonId": {"type": "integer", "description": "Unique person identifier", "required": true},
    "PersonNumber": {"type": "string", "description": "Employee ID number (e.g., EMP001)", "required": false},
    "DisplayName": {"type": "string", "description": "Full display name", "required": false},
    "FirstName": {"type": "string", "description": "First name", "required": false},
    "LastName": {"type": "string", "description": "Last name", "required": false},
    "MiddleNames": {"type": "string", "description": "Middle names", "required": false},
    "DateOfBirth": {"type": "date", "description": "Date of birth", "required": false},
    "Gender": {"type": "string", "description": "Gender", "required": false},
    "Nationality": {"type": "string", "description": "Nationality", "required": false},
    "MaritalStatus": {"type": "string", "description": "Marital status", "required": false},
    "DepartmentId": {"type": "integer", "description": "Department ID (foreign key to departments)", "required": false},
    "DepartmentName": {"type": "string", "description": "Department name", "required": false},
    "JobId": {"type": "integer", "description": "Job ID (foreign key to jobs)", "required": false},
    "JobName": {"type": "string", "description": "Job title", "required": false},
    "PositionId": {"type": "integer", "description": "Position ID (foreign key to positions)", "required": false},
    "PositionName": {"type": "string", "description": "Position name", "required": false},
    "LocationId": {"type": "integer", "description": "Location ID (foreign key to locations)", "required": false},
    "LocationName": {"type": "string", "description": "Work location name", "required": false},
    "WorkerType": {"type": "string", "description": "Worker type: EMPLOYEE, CONTINGENT_WORKER, PENDING_WORKER", "required": false},
    "EmploymentStatus": {"type": "string", "description": "Employment status: ACTIVE, INACTIVE, TERMINATED", "required": false},
    "HireDate": {"type": "date", "description": "Original hire date", "required": false},
    "PeriodOfServiceStartDate": {"type": "date", "description": "Current service period start date", "required": false},
    "WorkEmail": {"type": "string", "description": "Work email address", "required": false},
    "EmailAddress": {"type": "string", "description": "Primary email address", "required": false},
    "WorkPhone": {"type": "string", "description": "Work phone number", "required": false},
    "PhoneNumber": {"type": "string", "description": "Primary phone number", "required": false},
    "ManagerId": {"type": "integer", "description": "Manager's PersonId", "required": false},
    "ManagerName": {"type": "string", "description": "Manager's display name", "required": false},
    "GradeId": {"type": "integer", "description": "Grade ID (foreign key to grades)", "required": false},
    "GradeName": {"type": "string", "description": "Grade name", "required": false},
    "Salary": {"type": "number", "description": "Current salary amount", "required": false},
    "Currency": {"type": "string", "description": "Salary currency code", "required": false},
    "ActionCode": {"type": "string", "description": "Last action code", "required": false},
    "ActionReason": {"type": "string", "description": "Reason for last action", "required": false},
    "LastUpdateDate": {"type": "datetime", "description": "Last update timestamp", "required": false}
  },
  "childResources": {
    "addresses": {"endpoint": "child/addresses", "description": "Worker addresses"},
    "emails": {"endpoint": "child/emails", "description": "Worker email addresses"},
    "phoneNumbers": {"endpoint": "child/phoneNumbers", "description": "Worker phone numbers"},
    "assignments": {"endpoint": "child/assignments", "description": "Worker assignments"},
    "workRelationships": {"endpoint": "child/workRelationships", "description": "Work relationships"}
  }
}
