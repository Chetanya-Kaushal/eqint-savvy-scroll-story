    "ElementName": {"type": "string", "description": "Element name", "required": false},
    "Name": {"type": "string", "description": "Display name", "required": false},
    "Value": {"type": "number", "description": "Amount value", "required": false},
    "Currency": {"type": "string", "description": "Currency code", "required": false},
    "EffectiveStartDate": {"type": "date", "description": "Effective start date", "required": false},
    "EffectiveEndDate": {"type": "date", "description": "Effective end date", "required": false},
    "InputValueName": {"type": "string", "description": "Input value name", "required": false},
    "PayrollRelationshipId": {"type": "integer", "description": "Payroll relationship ID", "required": false}
  }
